{
  "uid": "orders-sla-lab4",
  "title": "Orders SLA under load",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "orders",
    "lab4",
    "sla"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "POST /order: p95 latency",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_request_duration_seconds_bucket{namespace=\"orders\",job=\"api\",method=\"POST\",path=\"/order\"}[2m])))",
          "legendFormat": "POST /order: p95 latency",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "POST /order: 5xx error ratio",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "(sum(rate(http_requests_total{namespace=\"orders\",job=\"api\",path=\"/order\",status=~\"5..\"}[2m])) / clamp_min(sum(rate(http_requests_total{namespace=\"orders\",job=\"api\",path=\"/order\"}[2m])),0.001)) or vector(0)",
          "legendFormat": "POST /order: 5xx error ratio",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API available replicas",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"orders\",deployment=\"api\"}",
          "legendFormat": "{{deployment}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Batch available vs desired",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available{namespace=\"orders\",deployment=\"batch\"}",
          "legendFormat": "available",
          "refId": "A"
        },
        {
          "expr": "kube_deployment_spec_replicas{namespace=\"orders\",deployment=\"batch\"}",
          "legendFormat": "desired",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    }
  ],
  "annotations": {
    "list": []
  }
}
